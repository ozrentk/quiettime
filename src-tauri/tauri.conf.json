{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiet Time",
  "version": "0.1.0",
  "identifier": "local.quiettime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Quiet Time", "width": 580, "height": 740,
      "minWidth": 480, "minHeight": 560, "center": true,
      "alwaysOnTop": true, "decorations": false, "visible": false
    }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost" }
  },
  "bundle": { "active": false, "icon": [] }
}
